{
  "name": "esm-nest-swc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/esm-nest-swc/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "outputs": ["{options.outputFile}", "{projectRoot}/.cache/.eslintcache"],
      "options": {
        "args": "--cache --cache-location .cache/.eslintcache --concurrency auto"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/esm-nest-swc",
        "commands": ["nest build", "nx run esm-nest-swc:typecheck --batch"]
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/esm-nest-swc",
        "commands": ["nest start --watch --type-check"]
      }
    }
  }
}
