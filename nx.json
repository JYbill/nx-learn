{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "ignore": [
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/.gitkeep",
      "!{projectRoot}/README.md"
    ],
    "production": [
      "default",
      "ignore",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": ["{projectRoot}/*.tsbuildinfo"]
  },
  "useInferencePlugins": true,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "serve": {
      "cache": false,
      "continuous": true
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"]
    }
  },
  "release": {
    "projects": ["libs/*"],
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "tui": {
    "enabled": false
  },
  "analytics": false,
  "neverConnectToCloud": true,
  "migrate": {
    "agentic": false
  }
}
